<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADAS THESIS - Town05M Swarm Traffic - ALKS ON (ADAS Active)
  Map   : Town05M.xodr  Road 37 (814m highway)
  Ego   : ALKS_R157SM_Controller (AEB + ACC)
  NPCs  : 8 vehicles via TrafficSwarmAction

  HOW TO RUN:
    cd C:\esmini
    .\bin\esmini --osc C:\adas-thesis\scenarios\S0_controller_demo\town05_swarm_ALKS_ON.xosc ^
                 --window 60 60 1200 600 --fixed_timestep 0.016

  WHAT TO WATCH:
    Ego (white) automatically maintains speed and brakes for close vehicles.
    Console prints ALKS decisions — AEB triggers, ACC adjustments.
    Compare with ALKS_OFF — Ego should never collide here.
-->
<OpenSCENARIO>

  <FileHeader revMajor="1" revMinor="1"
              date="2026-01-01T00:00:00"
              description="Town05M swarm ALKS ON - ADAS thesis"
              author="HasnainBadar"/>

  <ParameterDeclarations>
    <ParameterDeclaration name="EgoStartS"        parameterType="double"  value="400"/>
    <ParameterDeclaration name="EgoInitSpeed"     parameterType="double"  value="18.0"/>
    <ParameterDeclaration name="SwarmVehicles"    parameterType="integer" value="8"/>
    <ParameterDeclaration name="SwarmSpeed"       parameterType="double"  value="18.0"/>
    <ParameterDeclaration name="SwarmInnerRadius" parameterType="double"  value="20"/>
    <ParameterDeclaration name="SwarmMajorAxis"   parameterType="double"  value="200"/>
    <ParameterDeclaration name="SwarmMinorAxis"   parameterType="double"  value="40"/>
  </ParameterDeclarations>

  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="C:/esmini/resources/xosc/Catalogs/Vehicles"/>
    </VehicleCatalog>
    <ControllerCatalog>
      <Directory path="C:/esmini/resources/xosc/Catalogs/Controllers"/>
    </ControllerCatalog>
  </CatalogLocations>

  <RoadNetwork>
    <LogicFile filepath="C:/esmini/resources/xodr/Town05M.xodr"/>
  </RoadNetwork>

  <Entities>
    <!--
      ALKS defined inline with Properties — pattern from alks_r157_cut_in_quick_brake.xosc
      model=Regulation : ECE R157 safety regulation model
      logLevel=2       : prints ALKS decisions to console
      cruise=true      : ACC active — maintains speed and gap
    -->
    <ScenarioObject name="Ego">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_white"/>
      <ObjectController>
        <Controller name="ALKS_R157SM_Controller">
          <Properties>
            <Property name="model"    value="Regulation"/>
            <Property name="logLevel" value="2"/>
            <Property name="cruise"   value="true"/>
          </Properties>
        </Controller>
      </ObjectController>
    </ScenarioObject>
  </Entities>

  <Storyboard>
    <Init>
      <Actions>

        <!-- Same swarm as ALKS_OFF — identical parameters for fair comparison -->
        <GlobalAction>
          <TrafficAction>
            <TrafficSwarmAction
              innerRadius="$SwarmInnerRadius"
              semiMajorAxis="$SwarmMajorAxis"
              semiMinorAxis="$SwarmMinorAxis"
              numberOfVehicles="$SwarmVehicles"
              velocity="$SwarmSpeed"
              offset="0">
              <CentralObject entityRef="Ego"/>
            </TrafficSwarmAction>
          </TrafficAction>
        </GlobalAction>

        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="37" laneId="-1" offset="0" s="$EgoStartS">
                  <Orientation type="relative" h="0"/>
                </LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$EgoInitSpeed"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
          <!--
            Activate ALKS longitudinally only — pattern from alks_r157_cut_in_quick_brake.xosc
            longitudinal=true  = AEB + ACC active
            lateral=false      = lane keeping not activated (keeps scenario clean)
          -->
          <PrivateAction>
            <ControllerAction>
              <ActivateControllerAction longitudinal="true" lateral="false"/>
            </ControllerAction>
          </PrivateAction>
        </Private>

      </Actions>
    </Init>

    <Story name="MainStory">
      <Act name="MainAct">
        <ManeuverGroup maximumExecutionCount="1" name="MainMG">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Ego"/>
          </Actors>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0" rule="greaterThan"/>
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>

    <StopTrigger>
      <ConditionGroup>
        <Condition name="SimTimeLimit" delay="0" conditionEdge="none">
          <ByValueCondition>
            <SimulationTimeCondition value="180" rule="greaterThan"/>
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>

  </Storyboard>
</OpenSCENARIO>
