<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
   <FileHeader revMajor="1"
               revMinor="0"
               date="2025-01-01T00:00:00"
               description="S3 50kph AEB_A - pedestrian stops in lane, AEB fires"
               author="HasnainBadar"/>

   <ParameterDeclarations>
      <ParameterDeclaration name="EgoVehicle" parameterType="string" value="car_white"/>
      <ParameterDeclaration name="PedestrianSpeed" parameterType="double" value="1.2"/>
   </ParameterDeclarations>

   <CatalogLocations>
      <VehicleCatalog>
         <Directory path="C:/esmini/resources/xosc/Catalogs/Vehicles"/>
      </VehicleCatalog>
   </CatalogLocations>

   <RoadNetwork>
      <LogicFile filepath="C:/adas-thesis/maps/adas_network.xodr"/>
   </RoadNetwork>

   <Entities>
      <ScenarioObject name="Ego">
         <CatalogReference catalogName="VehicleCatalog" entryName="$EgoVehicle"/>
      </ScenarioObject>
      <ScenarioObject name="Pedestrian">
         <Pedestrian mass="80" model="EPTa" name="pedestrian_adult"
                     pedestrianCategory="pedestrian"
                     model3d="C:/esmini/resources/models/walkman.osgb">
            <ParameterDeclarations/>
            <BoundingBox>
               <Center x="0.06" y="0.0" z="0.923"/>
               <Dimensions height="1.8" length="0.6" width="0.5"/>
            </BoundingBox>
            <Properties>
               <Property name="scaleMode" value="BBToModel"/>
            </Properties>
         </Pedestrian>
      </ScenarioObject>
   </Entities>

   <Storyboard>
      <Init>
         <Actions>
            <!-- Ego: Road 13, lane 1, s=100, 50 kph = 13.89 m/s -->
            <Private entityRef="Ego">
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0.0"/>
                        <SpeedActionTarget>
                           <AbsoluteTargetSpeed value="13.89"/>
                        </SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <LanePosition roadId="13" laneId="1" offset="0" s="100"/>
                     </Position>
                  </TeleportAction>
               </PrivateAction>
            </Private>

            <!-- Pedestrian: left kerb offset=6, crosswalk s=5 -->
            <Private entityRef="Pedestrian">
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <LanePosition roadId="13" laneId="1" offset="6.0" s="5">
                           <Orientation type="absolute" h="3.927" p="0" r="0"/>
                        </LanePosition>
                     </Position>
                  </TeleportAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>

      <Story name="S3_Story">

         <!-- Pedestrian Act: walk into lane at t=0, stop after 5s -->
         <Act name="Pedestrian_Act">
            <ManeuverGroup maximumExecutionCount="1" name="Pedestrian_MG">
               <Actors selectTriggeringEntities="false">
                  <EntityRef entityRef="Pedestrian"/>
               </Actors>
               <Maneuver name="Pedestrian_Maneuver">

                  <Event name="PedestrianWalkEvent" priority="overwrite" maximumExecutionCount="1">
                     <Action name="WalkSpeed">
                        <PrivateAction>
                           <LongitudinalAction>
                              <SpeedAction>
                                 <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0.0"/>
                                 <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="$PedestrianSpeed"/>
                                 </SpeedActionTarget>
                              </SpeedAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>
                     <Action name="WalkTrajectory">
                        <PrivateAction>
                           <RoutingAction>
                              <FollowTrajectoryAction>
                                 <Trajectory closed="false" name="ped_traj">
                                    <ParameterDeclarations/>
                                    <Shape>
                                       <Polyline>
                                          <Vertex>
                                             <Position>
                                                <LanePosition roadId="13" laneId="1" offset="6.0" s="5">
                                                   <Orientation type="absolute" h="3.927" p="0" r="0"/>
                                                </LanePosition>
                                             </Position>
                                          </Vertex>
                                          <Vertex>
                                             <Position>
                                                <LanePosition roadId="13" laneId="1" offset="0.0" s="5">
                                                   <Orientation type="absolute" h="3.927" p="0" r="0"/>
                                                </LanePosition>
                                             </Position>
                                          </Vertex>
                                       </Polyline>
                                    </Shape>
                                 </Trajectory>
                                 <TimeReference>
                                    <None/>
                                 </TimeReference>
                                 <TrajectoryFollowingMode followingMode="follow"/>
                              </FollowTrajectoryAction>
                           </RoutingAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="PedWalkCondition" delay="0" conditionEdge="none">
                              <ByValueCondition>
                                 <SimulationTimeCondition value="0" rule="greaterOrEqual"/>
                              </ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>

                  <!-- Stop pedestrian 5s after walk starts = in lane centre by then -->
                  <Event name="PedestrianStopEvent" priority="overwrite" maximumExecutionCount="1">
                     <Action name="StopSpeed">
                        <PrivateAction>
                           <LongitudinalAction>
                              <SpeedAction>
                                 <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0.0"/>
                                 <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="0.0"/>
                                 </SpeedActionTarget>
                              </SpeedAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="PedStopCondition" delay="5.0" conditionEdge="rising">
                              <ByValueCondition>
                                 <StoryboardElementStateCondition storyboardElementType="event"
                                                                  storyboardElementRef="PedestrianWalkEvent"
                                                                  state="startTransition"/>
                              </ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>

               </Maneuver>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="Ped_ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition>
                        <SimulationTimeCondition value="0" rule="greaterOrEqual"/>
                     </ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>

         <!-- Ego AEB Act: same S1 pattern — hold speed then TTC fires brake -->
         <!-- No time gate — pedestrian is in lane from t=4.2s, Ego arrives at t=6.84s -->
         <!-- TTC=2.5s fires when gap=34.7m i.e. when Ego is at s=40, t~4.3s -->
         <!-- But pedestrian is still moving at t=4.3s so TTC won't fire cleanly -->
         <!-- Solution: use S1 exact pattern, single act, conditionEdge=rising -->
         <Act name="Ego_AEB_Act">
            <ManeuverGroup maximumExecutionCount="1" name="Ego_MG" actorRef="Ego">
               <Actors selectTriggeringEntities="false">
                  <EntityRef entityRef="Ego"/>
               </Actors>
               <Maneuver name="Ego_Maneuver">

                  <Event name="DriveConstant" priority="override">
                     <Action>
                        <PrivateAction>
                           <LongitudinalAction>
                              <SpeedAction>
                                 <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                                 <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="13.89"/>
                                 </SpeedActionTarget>
                              </SpeedAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="SimStart" delay="0" conditionEdge="none">
                              <ByValueCondition>
                                 <SimulationTimeCondition value="0" rule="greaterOrEqual"/>
                              </ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>

                  <!-- AEB fires on TTC — pedestrian stationary in lane from t=5s -->
                  <!-- At 50kph gap closes fast enough for clean TTC trigger -->
                  <Event name="AEB_Brake" priority="override">
                     <Action>
                        <PrivateAction>
                           <LongitudinalAction>
                              <SpeedAction>
                                 <SpeedActionDynamics dynamicsShape="linear" value="2" dynamicsDimension="time"/>
                                 <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="0"/>
                                 </SpeedActionTarget>
                              </SpeedAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="TTC_threshold" delay="0" conditionEdge="rising">
                              <ByEntityCondition>
                                 <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="Ego"/>
                                 </TriggeringEntities>
                                 <EntityCondition>
                                    <TimeToCollisionCondition value="2.5" rule="lessThan" freespace="false">
                                       <TimeToCollisionConditionTarget>
                                          <EntityRef entityRef="Pedestrian"/>
                                       </TimeToCollisionConditionTarget>
                                    </TimeToCollisionCondition>
                                 </EntityCondition>
                              </ByEntityCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>

               </Maneuver>
            </ManeuverGroup>
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="Ego_ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition>
                        <SimulationTimeCondition value="0" rule="greaterOrEqual"/>
                     </ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>

      </Story>

      <StopTrigger>
         <ConditionGroup>
            <Condition name="MinTime" delay="0" conditionEdge="none">
               <ByValueCondition>
                  <SimulationTimeCondition value="5" rule="greaterOrEqual"/>
               </ByValueCondition>
            </Condition>
            <Condition name="EgoStopped" delay="1" conditionEdge="none">
               <ByEntityCondition>
                  <TriggeringEntities triggeringEntitiesRule="any">
                     <EntityRef entityRef="Ego"/>
                  </TriggeringEntities>
                  <EntityCondition>
                     <SpeedCondition value="0.5" rule="lessThan"/>
                  </EntityCondition>
               </ByEntityCondition>
            </Condition>
         </ConditionGroup>
         <ConditionGroup>
            <Condition name="MaxTime" delay="0" conditionEdge="none">
               <ByValueCondition>
                  <SimulationTimeCondition value="60" rule="greaterOrEqual"/>
               </ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>

   </Storyboard>
</OpenSCENARIO>
