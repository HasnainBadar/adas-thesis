<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
   <FileHeader revMajor="1"
               revMinor="0"
               date="2025-01-01T00:00:00"
               description="S3 30kph baseline - pedestrian crossing no AEB"
               author="HasnainBadar"/>

   <ParameterDeclarations>
      <ParameterDeclaration name="EgoVehicle" parameterType="string" value="car_white"/>
      <ParameterDeclaration name="PedestrianSpeed" parameterType="double" value="1.2"/>
   </ParameterDeclarations>

   <CatalogLocations>
      <VehicleCatalog>
         <Directory path="C:/esmini/resources/xosc/Catalogs/Vehicles"/>
      </VehicleCatalog>
   </CatalogLocations>

   <RoadNetwork>
      <LogicFile filepath="C:/adas-thesis/maps/adas_network.xodr"/>
   </RoadNetwork>

   <Entities>
      <ScenarioObject name="Ego">
         <CatalogReference catalogName="VehicleCatalog" entryName="$EgoVehicle"/>
      </ScenarioObject>

      <!-- Inline pedestrian definition — same as esmini reference -->
      <ScenarioObject name="Pedestrian">
         <Pedestrian mass="80" model="EPTa" name="pedestrian_adult"
                     pedestrianCategory="pedestrian"
                     model3d="C:/esmini/resources/models/walkman.osgb">
            <ParameterDeclarations/>
            <BoundingBox>
               <Center x="0.06" y="0.0" z="0.923"/>
               <Dimensions height="1.8" length="0.6" width="0.5"/>
            </BoundingBox>
            <Properties>
               <Property name="scaleMode" value="BBToModel"/>
            </Properties>
         </Pedestrian>
      </ScenarioObject>
   </Entities>

   <Storyboard>
      <Init>
         <Actions>
            <!-- Ego: Road 13, lane 1 (toward junction), s=100, 30 kph = 8.33 m/s -->
            <Private entityRef="Ego">
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0.0"/>
                        <SpeedActionTarget>
                           <AbsoluteTargetSpeed value="8.33"/>
                        </SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <LanePosition roadId="13" laneId="1" offset="0" s="100"/>
                     </Position>
                  </TeleportAction>
               </PrivateAction>
            </Private>

            <!-- Pedestrian: left kerb offset=+6, walks into Ego lane -->
            <Private entityRef="Pedestrian">
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <LanePosition roadId="13" laneId="1" offset="6.0" s="5">
                           <Orientation type="absolute" h="3.927" p="0" r="0"/>
                        </LanePosition>
                     </Position>
                  </TeleportAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>

      <Story name="S3_Story">

         <Act name="S3_Act">

            <!-- Pedestrian ManeuverGroup: walk across road using trajectory -->
            <ManeuverGroup maximumExecutionCount="1" name="Pedestrian_MG">
               <Actors selectTriggeringEntities="false">
                  <EntityRef entityRef="Pedestrian"/>
               </Actors>
               <Maneuver name="Pedestrian_Maneuver">
                  <Event name="PedestrianWalkEvent" priority="overwrite" maximumExecutionCount="1">

                     <!-- Set walking speed -->
                     <Action name="WalkSpeed">
                        <PrivateAction>
                           <LongitudinalAction>
                              <SpeedAction>
                                 <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0.0"/>
                                 <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="$PedestrianSpeed"/>
                                 </SpeedActionTarget>
                              </SpeedAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>

                     <Action name="WalkTrajectory">
                        <PrivateAction>
                           <RoutingAction>
                              <FollowTrajectoryAction>
                                 <Trajectory closed="false" name="ped_traj">
                                    <ParameterDeclarations/>
                                    <Shape>
                                       <Polyline>
                                          <Vertex>
                                             <Position>
                                                <LanePosition roadId="13" laneId="1" offset="6.0" s="5">
                                                   <Orientation type="absolute" h="3.927" p="0" r="0"/>
                                                </LanePosition>
                                             </Position>
                                          </Vertex>
                                          <Vertex>
                                             <Position>
                                                <LanePosition roadId="13" laneId="1" offset="0.0" s="5">
                                                   <Orientation type="absolute" h="3.927" p="0" r="0"/>
                                                </LanePosition>
                                             </Position>
                                          </Vertex>
                                          <!-- Extended end: well past Ego lane so pedestrian doesn't stop mid-road -->
                                          <Vertex>
                                             <Position>
                                                <LanePosition roadId="13" laneId="1" offset="-10.0" s="5">
                                                   <Orientation type="absolute" h="3.927" p="0" r="0"/>
                                                </LanePosition>
                                             </Position>
                                          </Vertex>
                                       </Polyline>
                                    </Shape>
                                 </Trajectory>
                                 <TimeReference>
                                    <None/>
                                 </TimeReference>
                                 <TrajectoryFollowingMode followingMode="follow"/>
                              </FollowTrajectoryAction>
                           </RoutingAction>
                        </PrivateAction>
                     </Action>

                     <StartTrigger>
                        <ConditionGroup>
                           <!-- Ego travels 50m: ~5.3s left to crosswalk, matches pedestrian crossing time -->
                           <Condition name="PedWalkCondition" delay="0" conditionEdge="rising">
                              <ByEntityCondition>
                                 <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="Ego"/>
                                 </TriggeringEntities>
                                 <EntityCondition>
                                    <TraveledDistanceCondition value="50"/>
                                 </EntityCondition>
                              </ByEntityCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
               </Maneuver>
            </ManeuverGroup>

            <StartTrigger>
               <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition>
                        <SimulationTimeCondition value="0" rule="greaterThan"/>
                     </ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>

      </Story>

      <StopTrigger>
         <ConditionGroup>
            <Condition name="MaxTime" delay="0" conditionEdge="none">
               <ByValueCondition>
                  <SimulationTimeCondition value="60" rule="greaterOrEqual"/>
               </ByValueCondition>
            </Condition>
         </ConditionGroup>
      </StopTrigger>

   </Storyboard>
</OpenSCENARIO>
