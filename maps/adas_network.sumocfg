<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="C:\adas-thesis\maps\adas_network.net.xml"/>
        <route-files value="C:\adas-thesis\maps\adas_networkV2.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="99999"/>
        <step-length value="0.05"/>
